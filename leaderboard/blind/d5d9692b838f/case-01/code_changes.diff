+
+def _stable_stripe(key: str, mod: int) -> int:
+    digest = hashlib.blake2b(key.encode("utf-8"), digest_size=4).digest()
+    return int.from_bytes(digest, "little") % mod
+
+
+class TenantEpochs:
+    """单租户五维解耦纪元计数器（互不干扰，避免单维写操作波及无关缓存）。"""
+
+    __slots__ = ("doc_epoch", "acl_epoch", "perm_epoch", "policy_epoch", "sanction_epoch")
+
+    def __init__(self) -> None:
+        self.doc_epoch = 1
+        self.acl_epoch = 1
+        self.perm_epoch = 1
+        self.policy_epoch = 1
+        self.sanction_epoch = 1
+
+
+class BoundedTenantMap:
+    """有界 LRU 租户缓存映射，防止恶意伪造租户流量导致内存无界增长。"""
+
+    __slots__ = ("_data", "_max_size", "_lock")
+
+    def __init__(self, max_size: int = _MAX_CACHED_TENANTS) -> None:
+        self._data: OrderedDict[str, Any] = OrderedDict()
+        self._max_size = max_size
+        self._lock = threading.Lock()
+
+    def get(self, key: str) -> Any:
+        with self._lock:
+            val = self._data.get(key)
+            if val is not None:
+                self._data.move_to_end(key)
+            return val
+
+    def set(self, key: str, value: Any) -> None:
+        with self._lock:
+            self._data[key] = value
+            self._data.move_to_end(key)
+            while len(self._data) > self._max_size:
+                self._data.popitem(last=False)
+
+    def pop(self, key: str) -> Any:
+        with self._lock:
+            return self._data.pop(key, None)
+
+    def clear(self) -> None:
+        with self._lock:
+            self._data.clear()
+
+
+class DbRuntimeHub:
+    """单数据库实例的有界连接池、统一全局锁偏序协调器与多维租户缓存中枢。
+
+    全局锁偏序（严格由外向内获取，彻底消除跨层/双向交叉死锁）：
+      Layer 1: tenant_risk_lock(tenant_id)        —— 租户级风控批次与图窗串行锁
+      Layer 2: quota_locks(tenant_id, *buckets)   —— 按条带下标升序加锁的配额池锁（或 token_lock）
+      Layer 3: sqlite_write_lock + BEGIN IMMEDIATE —— SQLite 底层单写者快速互斥事务锁
+    """
+
+    __slots__ = (
+        "db_path",
+        "_pool",
+        "_closed",
+        "sqlite_write_lock",
+        "_risk_stripes",
+        "_quota_stripes",
+        "_token_stripes",
+        "_doc_stripes",
+        "_meta_stripes",
+        "_epochs_lock",
+        "_epochs",
+        "doc_indices",
+        "acl_snapshots",
+        "perm_snapshots",
+        "policy_snapshots",
+        "sanction_snapshots",
+        "risk_states",
+        "tenant_records",
+    )
+
+    def __init__(self, db_path: str) -> None:
+        self.db_path = db_path
+        self._pool: queue.LifoQueue[sqlite3.Connection] = queue.LifoQueue(maxsize=_CONN_POOL_MAXSIZE)
+        self._closed = False
+        self.sqlite_write_lock = threading.Lock()
+        self._risk_stripes = tuple(threading.RLock() for _ in range(128))
+        self._quota_stripes = tuple(threading.Lock() for _ in range(256))
+        self._token_stripes = tuple(threading.Lock() for _ in range(64))
+        self._doc_stripes = tuple(threading.RLock() for _ in range(128))
+        self._meta_stripes = tuple(threading.RLock() for _ in range(128))
+        self._epochs_lock = threading.Lock()
+        self._epochs: OrderedDict[str, TenantEpochs] = OrderedDict()
+
+        self.doc_indices = BoundedTenantMap(_MAX_CACHED_TENANTS)
+        self.acl_snapshots = BoundedTenantMap(_MAX_CACHED_TENANTS)
+        self.perm_snapshots = BoundedTenantMap(_MAX_CACHED_TENANTS)
+        self.policy_snapshots = BoundedTenantMap(_MAX_CACHED_TENANTS)
+        self.sanction_snapshots = BoundedTenantMap(_MAX_CACHED_TENANTS)
+        self.risk_states = BoundedTenantMap(_MAX_CACHED_TENANTS)
+        self.tenant_records = BoundedTenantMap(_MAX_CACHED_TENANTS)
+
+    def _new_pooled_conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(
+            self.db_path,
+            timeout=30.0,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute("PRAGMA temp_store=MEMORY")
+        conn.execute("PRAGMA cache_size=-8000")
+        conn.execute("PRAGMA busy_timeout=30000")
+        return conn
+
+    def acquire_conn(self) -> sqlite3.Connection:
+        try:
+            return self._pool.get_nowait()
+        except queue.Empty:
+            return self._new_pooled_conn()
+
+    def release_conn(self, conn: sqlite3.Connection) -> None:
+        try:
+            if conn.in_transaction:
+                conn.execute("ROLLBACK")
+        except sqlite3.Error:
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+            return
+
+        if self._closed:
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+            return
+
+        try:
+            self._pool.put_nowait(conn)
+        except queue.Full:
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+
+    def close(self) -> None:
+        self._closed = True
+        while True:
+            try:
+                conn = self._pool.get_nowait()
+            except queue.Empty:
+                break
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+        self.doc_indices.clear()
+        self.acl_snapshots.clear()
+        self.perm_snapshots.clear()
+        self.policy_snapshots.clear()
+        self.sanction_snapshots.clear()
+        self.risk_states.clear()
+        self.tenant_records.clear()
+
+    def get_epochs(self, tenant_id: str) -> TenantEpochs:
+        with self._epochs_lock:
+            ep = self._epochs.get(tenant_id)
+            if ep is not None:
+                self._epochs.move_to_end(tenant_id)
+                return ep
+            ep = TenantEpochs()
+            self._epochs[tenant_id] = ep
+            while len(self._epochs) > _MAX_CACHED_TENANTS * 2:
+                self._epochs.popitem(last=False)
+            return ep
+
+    def bump_doc_epoch(self, tenant_id: str) -> int:
+        with self._epochs_lock:
+            ep = self._epochs.get(tenant_id)
+            if ep is None:
+                ep = TenantEpochs()
+                self._epochs[tenant_id] = ep
+            ep.doc_epoch += 1
+            return ep.doc_epoch
+
+    def bump_acl_epoch(self, tenant_id: str) -> int:
+        with self._epochs_lock:
+            ep = self._epochs.get(tenant_id)
+            if ep is None:
+                ep = TenantEpochs()
+                self._epochs[tenant_id] = ep
+            ep.acl_epoch += 1
+            return ep.acl_epoch
+
+    def bump_perm_epoch(self, tenant_id: str) -> int:
+        with self._epochs_lock:
+            ep = self._epochs.get(tenant_id)
+            if ep is None:
+                ep = TenantEpochs()
+                self._epochs[tenant_id] = ep
+            ep.perm_epoch += 1
+            return ep.perm_epoch
+
+    def bump_policy_epoch(self, tenant_id: str) -> int:
+        with self._epochs_lock:
+            ep = self._epochs.get(tenant_id)
+            if ep is None:
+                ep = TenantEpochs()
+                self._epochs[tenant_id] = ep
+            ep.policy_epoch += 1
+            return ep.policy_epoch
+
+    def bump_sanction_epoch(self, tenant_id: str) -> int:
+        with self._epochs_lock:
+            ep = self._epochs.get(tenant_id)
+            if ep is None:
+                ep = TenantEpochs()
+                self._epochs[tenant_id] = ep
+            ep.sanction_epoch += 1
+            return ep.sanction_epoch
+
+    def tenant_risk_lock(self, tenant_id: str) -> threading.RLock:
+        return self._risk_stripes[_stable_stripe(tenant_id, len(self._risk_stripes))]
+
+    def tenant_doc_lock(self, tenant_id: str) -> threading.RLock:
+        return self._doc_stripes[_stable_stripe(tenant_id, len(self._doc_stripes))]
+
+    def tenant_meta_lock(self, tenant_id: str) -> threading.RLock:
+        return self._meta_stripes[_stable_stripe(tenant_id, len(self._meta_stripes))]
+
+    def token_lock(self, tenant_id: str) -> threading.Lock:
+        return self._token_stripes[_stable_stripe(tenant_id, len(self._token_stripes))]
+
+    @contextmanager
+    def quota_locks(self, tenant_id: str, *quota_types: str) -> Iterator[None]:
+        """按全局统一条带升序依次获取配额池锁（自动合并同条带碰撞，100% 免疫双向调拨死锁）。"""
+        stripe_indices = sorted(
+            {_stable_stripe(f"{tenant_id}\x00{qt}", len(self._quota_stripes)) for qt in quota_types}
+        )
+        acquired: list[threading.Lock] = []
+        try:
+            for idx in stripe_indices:
+                lk = self._quota_stripes[idx]
+                lk.acquire()
+                acquired.append(lk)
+            yield
+        finally:
+            for lk in reversed(acquired):
+                lk.release()
+
+
+_HUB_REGISTRY_LOCK = threading.Lock()
+_HUB_REGISTRY: OrderedDict[str, tuple[int, DbRuntimeHub]] = OrderedDict()
+
+
+def _normalize_db_key(db_path: str | pathlib.Path) -> str:
+    return str(pathlib.Path(db_path).resolve())
+
+
+def _file_ctime_sig(norm_path: str) -> int:
+    try:
+        return pathlib.Path(norm_path).stat().st_ctime_ns
+    except OSError:
+        return 0
+
+
+def get_db_hub(db_path: str | pathlib.Path) -> DbRuntimeHub:
+    if isinstance(db_path, str):
+        with _HUB_REGISTRY_LOCK:
+            fast_entry = _HUB_REGISTRY.get(db_path)
+            if fast_entry is not None:
+                _HUB_REGISTRY.move_to_end(db_path)
+                return fast_entry[1]
+
+    norm = _normalize_db_key(db_path)
+    ctime_ns = _file_ctime_sig(norm)
+    evicted: list[DbRuntimeHub] = []
+    with _HUB_REGISTRY_LOCK:
+        entry = _HUB_REGISTRY.get(norm)
+        if entry is not None:
+            old_ctime, hub = entry
+            if old_ctime == ctime_ns or old_ctime == 0:
+                if old_ctime == 0 and ctime_ns != 0:
+                    _HUB_REGISTRY[norm] = (ctime_ns, hub)
+                _HUB_REGISTRY.move_to_end(norm)
+                return hub
+            evicted.append(hub)
+            del _HUB_REGISTRY[norm]
+
+        hub = DbRuntimeHub(norm)
+        _HUB_REGISTRY[norm] = (ctime_ns, hub)
+        while len(_HUB_REGISTRY) > _MAX_ACTIVE_HUBS:
+            _, (_, old_hub) = _HUB_REGISTRY.popitem(last=False)
+            evicted.append(old_hub)
+
+    for h in evicted:
+        h.close()
+    return hub
+
+
+def reset_db_hub(db_path: str | pathlib.Path) -> None:
+    norm = _normalize_db_key(db_path)
+    old_hub: DbRuntimeHub | None = None
+    with _HUB_REGISTRY_LOCK:
+        entry = _HUB_REGISTRY.pop(norm, None)
+        if entry is not None:
+            old_hub = entry[1]
+    if old_hub is not None:
+        old_hub.close()
+
+
+@contextmanager
+def borrow_connection(db_path: str | pathlib.Path) -> Iterator[sqlite3.Connection]:
+    hub = get_db_hub(db_path)
+    conn = hub.acquire_conn()
+    try:
+        yield conn
+    finally:
+        hub.release_conn(conn)
+
+
+@contextmanager
+def write_transaction(db_path: str | pathlib.Path) -> Iterator[sqlite3.Connection]:
+    """Layer 3 原子写事务封装：严格在 sqlite_write_lock 内执行 BEGIN IMMEDIATE / COMMIT / ROLLBACK。"""
+    hub = get_db_hub(db_path)
+    with hub.sqlite_write_lock:
+        conn = hub.acquire_conn()
+        try:
+            conn.execute("BEGIN IMMEDIATE")
+            yield conn
+            conn.execute("COMMIT")
+        except BaseException:
+            if conn.in_transaction:
+                try:
+                    conn.execute("ROLLBACK")
+                except sqlite3.Error:
+                    pass
+            raise
+        finally:
+            hub.release_conn(conn)
