+def get_tenant_doc_index(db_path: str, tenant_id: str) -> TenantDocIndex:
+    """获取租户级增量文档倒排索引；仅在首次挂载存量库或异常纪元失步时按游标流式构建一次。"""
+    hub = get_db_hub(db_path)
