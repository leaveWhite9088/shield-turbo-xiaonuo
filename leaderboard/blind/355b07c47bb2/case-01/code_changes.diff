+MAX_POOL_CONNECTIONS = 32
+MAX_RUNTIMES = 16
+MAX_SEARCH_CACHE_PER_TENANT = 128
+
+
+def _configure_connection(conn: sqlite3.Connection) -> None:
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA busy_timeout = 30000")
+    conn.execute("PRAGMA journal_mode = WAL")
+    conn.execute("PRAGMA synchronous = NORMAL")
+    conn.execute("PRAGMA temp_store = MEMORY")
+    conn.execute("PRAGMA cache_size = -16384")
+
+
+class BoundedLRUCache:
+    """线程安全的有界 LRU 缓存。"""
+
+    __slots__ = ("_max_size", "_data", "_lock")
+
+    def __init__(self, max_size: int = MAX_SEARCH_CACHE_PER_TENANT) -> None:
+        self._max_size = max(1, int(max_size))
+        self._data: OrderedDict[Any, Any] = OrderedDict()
+        self._lock = threading.Lock()
+
+    def get(self, key: Any) -> Any | None:
+        with self._lock:
+            val = self._data.get(key)
+            if val is not None:
+                self._data.move_to_end(key)
+            return val
+
+    def put(self, key: Any, value: Any) -> None:
+        with self._lock:
+            if key in self._data:
+                self._data.move_to_end(key)
+            self._data[key] = value
+            while len(self._data) > self._max_size:
+                self._data.popitem(last=False)
+
+    def clear(self) -> None:
+        with self._lock:
+            self._data.clear()
+
+
+class BoundedConnectionPool:
+    """按数据库路径隔离的有界 SQLite 连接池（显式事务控制，严防连接泄漏与隐式锁升级）。"""
+
+    def __init__(self, db_path: str, max_size: int = MAX_POOL_CONNECTIONS) -> None:
+        self.db_path = db_path
+        self._max_size = max_size
+        self._idle: queue.LifoQueue[sqlite3.Connection] = queue.LifoQueue(maxsize=max_size)
+        self._sem = threading.BoundedSemaphore(max_size)
+        self._all_lock = threading.Lock()
+        self._all_conns: set[sqlite3.Connection] = set()
+        self._closed = False
+
+    def _create_conn(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(
+            self.db_path,
+            timeout=30.0,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        _configure_connection(conn)
+        with self._all_lock:
+            self._all_conns.add(conn)
+        return conn
+
+    def acquire(self) -> sqlite3.Connection:
+        self._sem.acquire()
+        try:
+            while True:
+                try:
+                    conn = self._idle.get_nowait()
+                except queue.Empty:
+                    return self._create_conn()
+                try:
+                    if conn.in_transaction:
+                        conn.execute("ROLLBACK")
+                    return conn
+                except sqlite3.Error:
+                    self._discard(conn)
+        except BaseException:
+            self._sem.release()
+            raise
+
+    def _discard(self, conn: sqlite3.Connection) -> None:
+        with self._all_lock:
+            self._all_conns.discard(conn)
+        try:
+            conn.close()
+        except sqlite3.Error:
+            pass
+
+    def release(self, conn: sqlite3.Connection, *, broken: bool = False) -> None:
+        try:
+            if broken or self._closed:
+                self._discard(conn)
+                return
+            try:
+                if conn.in_transaction:
+                    conn.execute("ROLLBACK")
+                self._idle.put_nowait(conn)
+            except (queue.Full, sqlite3.Error):
+                self._discard(conn)
+        finally:
+            self._sem.release()
+
+    def close_all(self) -> None:
+        self._closed = True
+        while True:
+            try:
+                conn = self._idle.get_nowait()
+            except queue.Empty:
+                break
+            self._discard(conn)
+        with self._all_lock:
+            remaining = list(self._all_conns)
+            self._all_conns.clear()
+        for conn in remaining:
+            try:
+                conn.close()
+            except sqlite3.Error:
+                pass
+
