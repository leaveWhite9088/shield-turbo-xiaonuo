+class SlidingMedianTracker:
+    """双堆（大顶堆 low + 小顶堆 high）+ 惰性删除维护 O(log W) 滑动窗口精确中位数。"""
+
+    __slots__ = ("low", "high", "delayed", "low_size", "high_size")
+
+    def __init__(self) -> None:
+        self.low: list[int] = []  # 存 -val，模拟大顶堆
+        self.high: list[int] = []  # 存 val，小顶堆
+        self.delayed: dict[int, int] = {}
+        self.low_size: int = 0
+        self.high_size: int = 0
+
+    def _prune_low(self) -> None:
+        low = self.low
+        delayed = self.delayed
+        while low:
+            top = -low[0]
+            cnt = delayed.get(top, 0)
+            if cnt > 0:
+                if cnt == 1:
+                    del delayed[top]
+                else:
+                    delayed[top] = cnt - 1
+                heapq.heappop(low)
+            else:
+                break
+
+    def _prune_high(self) -> None:
+        high = self.high
+        delayed = self.delayed
+        while high:
+            top = high[0]
+            cnt = delayed.get(top, 0)
+            if cnt > 0:
+                if cnt == 1:
+                    del delayed[top]
+                else:
+                    delayed[top] = cnt - 1
+                heapq.heappop(high)
+            else:
+                break
+
+    def _rebalance(self) -> None:
+        if self.low_size > self.high_size + 1:
+            self._prune_low()
+            val = -heapq.heappop(self.low)
+            heapq.heappush(self.high, val)
+            self.low_size -= 1
+            self.high_size += 1
+            self._prune_low()
+        elif self.low_size < self.high_size:
+            self._prune_high()
+            val = heapq.heappop(self.high)
+            heapq.heappush(self.low, -val)
+            self.high_size -= 1
+            self.low_size += 1
+            self._prune_high()
+
+    def add(self, val: int) -> None:
+        self._prune_low()
+        if not self.low or val <= -self.low[0]:
+            heapq.heappush(self.low, -val)
+            self.low_size += 1
+        else:
+            heapq.heappush(self.high, val)
+            self.high_size += 1
+        self._rebalance()
+
+    def remove(self, val: int) -> None:
+        self._prune_low()
+        self._prune_high()
+        self.delayed[val] = self.delayed.get(val, 0) + 1
+        if self.low and val <= -self.low[0]:
+            self.low_size -= 1
+            if val == -self.low[0]:
+                self._prune_low()
+        else:
+            self.high_size -= 1
+            if self.high and val == self.high[0]:
+                self._prune_high()
+        self._rebalance()
+
+    def median(self) -> int:
+        total = self.low_size + self.high_size
+        if total == 0:
+            return 0
+        self._prune_low()
+        if total & 1:
+            return -self.low[0]
+        self._prune_high()
+        return (-self.low[0] + self.high[0]) // 2
+
+    def clear(self) -> None:
+        self.low.clear()
+        self.high.clear()
+        self.delayed.clear()
+        self.low_size = 0
+        self.high_size = 0
+
