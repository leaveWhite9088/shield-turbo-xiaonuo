+class TenantAclState:
+    """与文档倒排索引完全正交解耦的租户隔离墙状态（独立 acl_epoch）。"""
+
+    __slots__ = ("tenant_id", "acl_epoch", "rules_by_doc")
+
+    def __init__(self, tenant_id: str) -> None:
+        self.tenant_id = tenant_id
