+def _build_org_lineages(parent_map: dict[str, str | None]) -> dict[str, tuple[str, ...]]:
+    lineages: dict[str, tuple[str, ...]] = {}
+    for node_id in parent_map:
+        chain: list[str] = []
+        curr: str | None = node_id
+        visited: set[str] = set()
+        while curr and curr not in visited:
+            visited.add(curr)
+            chain.append(curr)
