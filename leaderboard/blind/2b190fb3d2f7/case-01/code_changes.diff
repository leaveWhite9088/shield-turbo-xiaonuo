+class DualHeapMedian:
+    """基于大顶堆 + 小顶堆 + 惰性删除的 O(log W) 精确动态中位数结构。
+
+    不变式：
+    - low（大顶堆，存负值）与 high（小顶堆，存正值）满足：
+      low_size == high_size 或 low_size == high_size + 1；
+    - 经 prune 后，-low[0] <= high[0]。
+    """
+
+    __slots__ = ("_low", "_high", "_delayed", "_low_size", "_high_size")
+
+    def __init__(self) -> None:
+        self._low: list[int] = []
+        self._high: list[int] = []
+        self._delayed: dict[int, int] = {}
+        self._low_size: int = 0
+        self._high_size: int = 0
+
+    def _prune_low(self) -> None:
+        low = self._low
+        delayed = self._delayed
+        while low:
+            val = -low[0]
+            cnt = delayed.get(val, 0)
+            if cnt > 0:
+                heapq.heappop(low)
+                if cnt == 1:
+                    del delayed[val]
+                else:
+                    delayed[val] = cnt - 1
+            else:
+                break
+
+    def _prune_high(self) -> None:
+        high = self._high
+        delayed = self._delayed
+        while high:
+            val = high[0]
+            cnt = delayed.get(val, 0)
+            if cnt > 0:
+                heapq.heappop(high)
+                if cnt == 1:
+                    del delayed[val]
+                else:
+                    delayed[val] = cnt - 1
+            else:
+                break
+
+    def _rebalance(self) -> None:
+        if self._low_size > self._high_size + 1:
+            self._prune_low()
+            val = -heapq.heappop(self._low)
+            self._low_size -= 1
+            heapq.heappush(self._high, val)
+            self._high_size += 1
+            self._prune_low()
+        elif self._low_size < self._high_size:
+            self._prune_high()
+            val = heapq.heappop(self._high)
+            self._high_size -= 1
+            heapq.heappush(self._low, -val)
+            self._low_size += 1
+            self._prune_high()
+
+    def add(self, val: int) -> None:
+        if self._low_size == 0:
+            heapq.heappush(self._low, -val)
+            self._low_size += 1
+            return
+        self._prune_low()
+        if val <= -self._low[0]:
+            heapq.heappush(self._low, -val)
+            self._low_size += 1
+        else:
+            heapq.heappush(self._high, val)
+            self._high_size += 1
+        self._rebalance()
+
+    def remove(self, val: int) -> None:
+        self._prune_low()
+        in_low = bool(self._low) and val <= -self._low[0]
+        self._delayed[val] = self._delayed.get(val, 0) + 1
+        if in_low:
+            self._low_size -= 1
+            if self._low and val == -self._low[0]:
+                self._prune_low()
+        else:
+            self._high_size -= 1
+            if self._high and val == self._high[0]:
+                self._prune_high()
+        self._rebalance()
+
+    def median(self) -> int:
+        total = self._low_size + self._high_size
+        if total == 0:
+            return 0
+        self._prune_low()
+        if total & 1:
+            return int(-self._low[0])
+        self._prune_high()
+        return int((-self._low[0] + self._high[0]) // 2)
