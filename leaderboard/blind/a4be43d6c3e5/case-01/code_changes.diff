+
+    def _prune_high(self) -> None:
+        while self._high:
+            top = self._high[0]
+            if self._delayed_high[top] > 0:
+                self._delayed_high[top] -= 1
+                heapq.heappop(self._high)
+            else:
+                break
+
+    def _rebalance(self) -> None:
+        self._prune_low()
+        self._prune_high()
+        if self.low_size > self.high_size + 1:
