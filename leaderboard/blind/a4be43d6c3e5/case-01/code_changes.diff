+        self._high: list[int] = []
+        self._low_active: Counter[int] = Counter()
+        self._high_active: Counter[int] = Counter()
+        self._delayed_low: Counter[int] = Counter()
+        self._delayed_high: Counter[int] = Counter()
+        self.low_size = 0
+        self.high_size = 0
+
+    def _prune_low(self) -> None:
+        while self._low:
