+            self._low_active[val] -= 1
+            self.low_size -= 1
+            heapq.heappush(self._high, val)
+            self._high_active[val] += 1
+            self.high_size += 1
+            self._prune_low()
+        elif self.high_size > self.low_size:
+            val = heapq.heappop(self._high)
+            self._high_active[val] -= 1
+            self.high_size -= 1
+            heapq.heappush(self._low, -val)
+            self._low_active[val] += 1
+            self.low_size += 1
