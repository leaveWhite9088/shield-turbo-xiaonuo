+    def search(self, start: int, text: str) -> bool:
+        current: set[int] = set()
+        text_len = len(text)
+
+        def closure(seeds: set[int], position: int) -> set[int]:
+            result: set[int] = set()
+            stack = list(seeds)
+            while stack:
+                state_id = stack.pop()
+                if state_id in result:
+                    continue
