+class _ConnectionPool:
+    """小型有界空闲连接池；检出的连接仍由单个请求独占。"""
+
+    def __init__(self, path: str, max_idle: int = 8) -> None:
+        self.path = path
+        self.max_idle = max_idle
+        self._idle: list[sqlite3.Connection] = []
+        self._lock = threading.Lock()
+
+    def acquire(self) -> sqlite3.Connection:
+        with self._lock:
+            if self._idle:
+                return self._idle.pop()
+        conn = sqlite3.connect(self.path, timeout=30.0, check_same_thread=False)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA busy_timeout=30000")
+        conn.execute("PRAGMA foreign_keys=ON")
+        return conn
+
+    def release(self, conn: sqlite3.Connection) -> None:
+        try:
+            if conn.in_transaction:
+                conn.rollback()
+            with self._lock:
+                if len(self._idle) < self.max_idle:
+                    self._idle.append(conn)
+                    return
+        except sqlite3.Error:
+            pass
+        conn.close()
+
+    def clear(self) -> None:
+        with self._lock:
+            idle, self._idle = self._idle, []
+        for conn in idle:
+            conn.close()
+
+
+_POOLS: dict[str, _ConnectionPool] = {}
+_POOLS_GUARD = threading.Lock()
+
+
+class PooledConnection:
+    """保持 sqlite3.Connection 常用接口，close() 将连接归还池中。"""
+
+    def __init__(self, conn: sqlite3.Connection, pool: _ConnectionPool) -> None:
+        object.__setattr__(self, "_conn", conn)
+        object.__setattr__(self, "_pool", pool)
+        object.__setattr__(self, "_closed", False)
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._conn, name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        setattr(self._conn, name, value)
+
+    def close(self) -> None:
+        if not self._closed:
+            object.__setattr__(self, "_closed", True)
+            self._pool.release(self._conn)
+
+
+def _pool_for(db_path: str | pathlib.Path) -> _ConnectionPool:
+    path = str(pathlib.Path(db_path).resolve())
+    with _POOLS_GUARD:
+        pool = _POOLS.get(path)
+        if pool is None:
+            pool = _ConnectionPool(path)
+            _POOLS[path] = pool
+        return pool
+
+
+def open_connection(db_path: str | pathlib.Path) -> PooledConnection:
+    pool = _pool_for(db_path)
+    return PooledConnection(pool.acquire(), pool)
 
 
