-            if ordered[j] > ordered[j + 1]:
-                ordered[j], ordered[j + 1] = ordered[j + 1], ordered[j]
     mid = n // 2
     if n % 2 == 1:
         return int(ordered[mid])
     return int((ordered[mid - 1] + ordered[mid]) // 2)
