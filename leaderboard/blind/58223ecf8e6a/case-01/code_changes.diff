+
+class PooledConnection:
+    """sqlite3.Connection 的窄代理，保持现有 execute/commit/close 调用兼容。"""
+
+    __slots__ = ("_pool", "_raw", "_nested", "_closed")
+
+    def __init__(self, pool: _ConnectionPool, raw: sqlite3.Connection, nested: bool) -> None:
+        self._pool = pool
+        self._raw = raw
+        self._nested = nested
+        self._closed = False
+
+    def execute(self, *args: Any, **kwargs: Any) -> sqlite3.Cursor:
+        return self._raw.execute(*args, **kwargs)
+
+    def executemany(self, *args: Any, **kwargs: Any) -> sqlite3.Cursor:
+        return self._raw.executemany(*args, **kwargs)
+
+    def executescript(self, *args: Any, **kwargs: Any) -> sqlite3.Cursor:
+        return self._raw.executescript(*args, **kwargs)
+
+    def commit(self) -> None:
+        self._raw.commit()
+
+    def rollback(self) -> None:
+        self._raw.rollback()
