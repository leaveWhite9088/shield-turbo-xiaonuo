+# ---------------------------------------------------------------------------
+# 借还式线程安全 SQLite 连接池（同一时刻一条物理连接仅被一个借用线程独占使用）。
+# 借用方调用 close() 时若存在未提交事务先回滚再归还池中复用，避免半截事务污染。
+# ---------------------------------------------------------------------------
+_POOL_MAX_IDLE = 8
+_conn_pool: dict[str, list[sqlite3.Connection]] = {}
+_pool_lock = threading.Lock()
+
+
+def _create_raw_connection(db_key: str) -> sqlite3.Connection:
+    conn = sqlite3.connect(db_key, timeout=30.0, check_same_thread=False)
     conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA busy_timeout = 30000")
+    conn.execute("PRAGMA synchronous = NORMAL")
+    conn.execute("PRAGMA temp_store = MEMORY")
+    conn.execute("PRAGMA cache_size = -2000")
     return conn
+
+
+def _discard_raw_connection(conn: sqlite3.Connection) -> None:
+    try:
+        conn.close()
+    except Exception:
+        pass
+
+
+class _PooledConnection:
+    """SQLite 连接池借还包装：close() 即无损归还，未决事务自动回滚。"""
+
+    __slots__ = ("_conn", "_db_key", "_released")
+
+    def __init__(self, conn: sqlite3.Connection, db_key: str) -> None:
+        self._conn = conn
+        self._db_key = db_key
+        self._released = False
+
+    def __getattr__(self, name: str) -> Any:
+        if self._released:
+            raise sqlite3.ProgrammingError("pooled connection already released")
+        return getattr(self._conn, name)
+
+    def __enter__(self) -> "_PooledConnection":
+        return self
+
+    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> bool:
+        self.close()
+        return False
+
+    def close(self) -> None:
+        if self._released:
+            return
+        self._released = True
+        conn = self._conn
+        try:
+            if conn.in_transaction:
+                conn.rollback()
+        except Exception:
+            _discard_raw_connection(conn)
+            return
+        with _pool_lock:
+            idle = _conn_pool.get(self._db_key)
+            if idle is not None and len(idle) < _POOL_MAX_IDLE:
+                idle.append(conn)
+                return
+        _discard_raw_connection(conn)
+
+
+def open_connection(db_path: str | pathlib.Path) -> _PooledConnection:
+    db_key = str(db_path)
+    conn: sqlite3.Connection | None = None
+    with _pool_lock:
+        idle = _conn_pool.get(db_key)
+        if idle:
+            conn = idle.pop()
+    if conn is None:
+        conn = _create_raw_connection(db_key)
+    return _PooledConnection(conn, db_key)
 
 
