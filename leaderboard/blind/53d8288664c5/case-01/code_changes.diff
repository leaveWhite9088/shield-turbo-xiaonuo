+def _split_top_level_alternation(content: str) -> list[str] | None:
+    """按深度 0 的 '|' 切分交替分支；无交替时返回 None。"""
+    branches: list[str] = []
+    depth = 0
+    in_class = False
+    seg_start = 0
+    i = 0
+    n = len(content)
+    while i < n:
+        ch = content[i]
+        if ch == "\\":
+            i += 2
+            continue
+        if in_class:
+            if ch == "]":
+                in_class = False
+            i += 1
+            continue
+        if ch == "[":
+            in_class = True
+            i += 1
+            continue
+        if ch == "(":
+            depth += 1
+            i += 1
+            continue
+        if ch == ")":
+            depth -= 1
+            i += 1
+            continue
+        if ch == "|" and depth == 0:
+            branches.append(content[seg_start:i])
+            seg_start = i + 1
+        i += 1
+    branches.append(content[seg_start:])
+    return branches if len(branches) > 1 else None
+
