+def _precheck_json_nesting_depth(raw: str) -> int:
+    """在 json.loads 之前用 O(N) 状态机扫描原始文本的最大花括号/方括号嵌套深度。
+
+    字符串字面量内的括号不计入；畸形不闭合的载荷交给 json.loads 原有语义报 400。
+    """
+    depth = 0
+    max_depth = 0
+    in_str = False
+    escaped = False
+    for ch in raw:
+        if in_str:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == '"':
+                in_str = False
+            continue
+        if ch == '"':
+            in_str = True
+        elif ch == "{" or ch == "[":
+            depth += 1
+            if depth > max_depth:
+                max_depth = depth
+                if max_depth > _MAX_JSON_DEPTH:
+                    return max_depth
+        elif ch == "}" or ch == "]":
+            if depth > 0:
+                depth -= 1
+    return max_depth
 
 
