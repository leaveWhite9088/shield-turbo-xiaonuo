+def _collect_group_contents(content: str) -> list[str]:
+    """收集 content 自身及其中全部括号子表达式的内容文本（跳过字符类与转义）。"""
+    results = [content]
+    starts: list[int] = []
+    i = 0
+    n = len(content)
+    while i < n:
+        ch = content[i]
+        if ch == "\\":
+            i += 2
+            continue
+        if ch == "[":
+            j = i + 1
+            if j < n and content[j] == "^":
+                j += 1
+            if j < n and content[j] == "]":
+                j += 1
+            while j < n and content[j] != "]":
+                if content[j] == "\\":
+                    j += 1
+                j += 1
+            i = j + 1
+            continue
+        if ch == "(":
+            starts.append(i)
+            i += 1
+            if i < n and content[i] == "?":
+                i += 1
+            continue
+        if ch == ")" and starts:
+            s = starts.pop()
+            results.append(content[s + 1 : i])
+            i += 1
+            continue
+        i += 1
