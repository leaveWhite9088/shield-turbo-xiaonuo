+                stack[-1][0] = True
+                i = m.end()
+                prev_was_quantifier = True
+                pending_group = None
+                continue
+            i += 1
+            prev_was_quantifier = False
+            pending_group = None
+            continue
+        i += 1
+        prev_was_quantifier = False
+        pending_group = None
+    return
+
