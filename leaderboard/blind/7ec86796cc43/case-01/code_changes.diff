+def measure_json_depth(raw: str) -> int:
+    """零额外内存地扫描 JSON 文本的最大嵌套深度（解析前预检）。"""
+    depth = 0
+    max_depth = 0
+    in_string = False
+    escaped = False
+    for ch in raw:
+        if in_string:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == '"':
+                in_string = False
+            continue
+        if ch == '"':
+            in_string = True
+        elif ch == "{" or ch == "[":
+            depth += 1
+            if depth > max_depth:
+                max_depth = depth
+        elif ch == "}" or ch == "]":
+            depth -= 1
+    return max_depth
+
+
+def measure_structure_depth(node: Any, depth: int = 0) -> int:
+    """已解析对象（dict/list）的嵌套深度测量。"""
+    if depth > MAX_JSON_DEPTH + 1:
+        return depth
+    max_depth = depth
+    if isinstance(node, dict):
+        for value in node.values():
+            child = measure_structure_depth(value, depth + 1)
+            if child > max_depth:
+                max_depth = child
+    elif isinstance(node, list):
+        for value in node:
+            child = measure_structure_depth(value, depth + 1)
+            if child > max_depth:
+                max_depth = child
+    return max_depth
+
