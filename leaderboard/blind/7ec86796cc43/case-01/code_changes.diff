+# ---------------------------------------------------------------------------
+# 连接池层：SQLite 连接创建开销（打开/关闭文件句柄、解析 schema 缓存）远高于
+# 单次查询本身。原实现每次业务调用都新建连接并在 N×M 的跨模块循环中反复开关，
+# 是端到端延迟的一阶来源。此处改为「按库路径复用的空闲连接池」：
+#   * 池容量有界（_MAX_IDLE_CONNECTIONS），杜绝连接数无界增长；
+#   * close() 语义保持「归还连接池」而非物理关闭，调用方代码零改动；
+#   * 归还前强制回滚未提交事务，杜绝跨请求事务污染与脏读。
+# ---------------------------------------------------------------------------
+_MAX_IDLE_CONNECTIONS = 8
+_POOL_LOCK = threading.Lock()
+_IDLE_CONNECTIONS: dict[str, list[sqlite3.Connection]] = {}
+_TUNED_DB_PATHS: set[str] = set()
