+class _PooledConnection(sqlite3.Connection):
+    """close() 语义为「归还连接池」的 SQLite 连接子类。"""
+
+    def close(self) -> None:  # noqa: D102 - sqlite3 API 覆写
+        pool_key = getattr(self, "_aegis_pool_key", None)
+        if not pool_key:
+            super().close()
+            return
+        try:
+            if self.in_transaction:
+                self.execute("ROLLBACK")
+        except Exception:
+            try:
+                super().close()
+            except Exception:
+                pass
+            return
+        with _POOL_LOCK:
+            bucket = _IDLE_CONNECTIONS.setdefault(pool_key, [])
+            if bucket is not None and len(bucket) < _MAX_IDLE_CONNECTIONS:
+                self._aegis_pool_key = None  # type: ignore[attr-defined]
+                bucket.append(self)
+                return
+        try:
+            super().close()
+        except Exception:
+            pass
