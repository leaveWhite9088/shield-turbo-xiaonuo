+            ev = events.get(tx_id)
+            if ev is None or ev[1] != ts:
+                continue                      # 已被同 tx_id 的后续事件覆盖
+            del events[tx_id]
+            amount.add(ev[0], -1)
+            self.count -= 1
+            self.total -= ev[0]
+            n = cps.get(ev[2], 0) - 1
+            if n > 0:
+                cps[ev[2]] = n
+            else:
+                cps.pop(ev[2], None)
+        if not events:
+            heap.clear()
