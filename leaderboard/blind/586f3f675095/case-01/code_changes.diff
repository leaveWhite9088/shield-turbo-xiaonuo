+class ExactMedianFenwick:
+    """金额直方图：O(Bits) 增删 + O(Bits) 第 k 小定位，支持 0..2^Bits-1 的整数金额。"""
+
+    __slots__ = ("tree", "bits", "size", "count")
+
+    def __init__(self, bits: int = FENWICK_BITS) -> None:
+        self.bits = bits
+        self.size = 1 << bits
+        self.tree = [0] * (self.size + 1)
+        self.count = 0
+
+    def add(self, value: int, delta: int) -> None:
+        if value >= self.size:
+            self._grow(value)
+        tree = self.tree
+        size = self.size
+        self.count += delta
+        i = value + 1
+        while i <= size:
+            tree[i] += delta
+            i += i & (-i)
+
+    def _grow(self, value: int) -> None:
+        while value >= self.size:
+            self.bits += 1
+            self.size = 1 << self.bits
+        new_tree = [0] * (self.size + 1)
+        old_tree = self.tree
+        old_size = len(old_tree) - 1
+        for v in range(old_size):
+            c = old_tree[v + 1] - (old_tree[v] if v else 0)
+            if c:
+                i = v + 1
+                while i <= self.size:
+                    new_tree[i] += c
+                    i += i & (-i)
+        self.tree = new_tree
+
+    def prefix(self, value: int) -> int:
+        """返回金额 <= value 的计数。"""
+        if value < 0:
+            return 0
+        if value >= self.size:
+            return self.count
+        tree = self.tree
+        i = value + 1
+        s = 0
+        while i > 0:
+            s += tree[i]
+            i -= i & (-i)
+        return s
+
+    def kth(self, k: int) -> int:
+        """返回第 k 小（1 起）的金额。"""
+        tree = self.tree
+        size = self.size
+        idx = 0
+        bit = 1 << (size.bit_length() - 1)
+        while bit:
+            nxt = idx + bit
+            if nxt <= size and tree[nxt] < k:
+                idx = nxt
+                k -= tree[nxt]
+            bit >>= 1
+        return idx
+
+    def median(self) -> int:
+        n = self.count
+        if n <= 0:
+            return 0
+        mid = n // 2
+        if n % 2 == 1:
+            return self.kth(mid + 1)
+        return int((self.kth(mid) + self.kth(mid + 1)) // 2)
