+class CacheState:
+    """按数据库文件为键的全局缓存状态（含租户表静态缓存）。"""
+
+    def __init__(self, db_path: str) -> None:
+        self.db_path = db_path
+        self.lock = threading.RLock()
+        self.tenants: dict[str, TenantState] = {}
