+        role_map[nid] = str(r["inherited_role"]) if r["inherited_role"] else None
+
+    ancestors_by_node: dict[str, tuple[str, ...]] = {}
+    inherited_roles_by_node: dict[str, frozenset[str]] = {}
+
+    for nid in parent_map:
