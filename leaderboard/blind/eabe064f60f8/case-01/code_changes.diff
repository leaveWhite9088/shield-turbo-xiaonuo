+        "SELECT node_id, parent_node_id, inherited_role FROM org_nodes WHERE tenant_id = ?",
+        (tenant_id,),
+    ).fetchall()
+
+    parent_map: dict[str, str | None] = {}
+    role_map: dict[str, str | None] = {}
+    for r in rows:
+        nid = str(r["node_id"])
